{
  "schema_version": 1,
  "experiment_id": "livechat_pinyingpt_generic_baseline_v1",
  "seed": 40408,
  "dataset": {
    "official_repository": "https://github.com/gaojingsheng/LiveChat",
    "official_revision": "d06c90aae0cedc1d75792c84e6bc140828c90ded",
    "download_folder_url": "https://drive.google.com/drive/folders/1q2GXfeNRN5bOr2Hc5aDneiBXXVfGN45V?usp=sharing",
    "root": ".cache/livechat",
    "source_split": "RawDialogueData/train_data.pk",
    "audit_splits": [
      "RawDialogueData/train_data.pk",
      "RawDialogueData/dev_data.pk",
      "RawDialogueData/test_data.pk"
    ],
    "development_uses_official_dev_test": false
  },
  "selection": {
    "deep_user_min_usable_responses": 2400,
    "max_users": 100,
    "history_ratio": 0.7,
    "evaluation_ratio": 0.3,
    "chronology_fallback": "stable_hash_session_disjoint_non_temporal_proxy",
    "max_evaluation_interactions_per_user": 100,
    "target_selection": "one_eligible_jieba_span_per_response_by_stable_hash",
    "evaluation_sampling": "lowest_stable_hash_for_grade_c_or_d"
  },
  "text": {
    "unicode_normalization": "none",
    "whitespace_normalization": "strip_for_usable_check_only",
    "traditional_to_simplified_conversion": false,
    "segmentation": {
      "library": "jieba",
      "version": "0.42.1",
      "mode": "default",
      "custom_dictionary": null
    },
    "pinyin": {
      "library": "pypinyin",
      "version": "0.55.0",
      "style": "NORMAL",
      "tone_free": true,
      "lowercase": true,
      "strict": true,
      "one_syllable_per_character": true
    }
  },
  "model": {
    "checkpoint": "aihijo/transformers4ime-pinyingpt-concat",
    "checkpoint_path": ".build/pinyingpt2-concat",
    "checkpoint_revision": "76dd20dc92d8236a350fb732e99dde6fa15e2263",
    "official_code_revision": "8f1573ed0bd4d1f3d8d3f10a05f7e870725646f1",
    "beam_size": 16,
    "top_k": 10,
    "context_token_limit": 512,
    "conditions": ["pinyin_only", "contextual"]
  },
  "analysis": {
    "ambiguity_definition": "sum(log2(number of PinyinGPT-compatible characters at each Pinyin position))",
    "ambiguity_bins": "quartiles computed on frozen interactions before inference",
    "target_length_long_tail_policy": "from the maximum length downward, merge contiguous longest lengths until the merged bin has at least 100 frozen interactions; label the bin N+",
    "target_length_long_tail_min_interactions": 100,
    "context_length_bins": ["0", "1-5", "6-10", "11-20", "21+"],
    "bootstrap_resamples": 10000,
    "bootstrap_confidence": 0.95
  },
  "output_dir": "results/experiments/livechat_pinyingpt_generic_baseline_v1"
}
